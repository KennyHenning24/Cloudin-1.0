# Copiar a .env y ajustar. El .env nunca se sube al repositorio.

SECRET_KEY=cambiar-esto-en-produccion
DEBUG=1
ALLOWED_HOSTS=*

# Llave con la que se cifran las contraseñas que el panel maestro puede mostrar.
# Generar una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si se pierde o se cambia, las contraseñas guardadas quedan ilegibles: las
# cuentas siguen funcionando, pero hay que regenerar cada contraseña.
CREDENTIAL_KEY=

# Dominio base para los subdominios de cada restaurante:
# lajoya.cloudin.app -> slug "lajoya". En local se usa localhost.
TENANT_BASE_DOMAIN=localhost

# Motor de las bases por restaurante: sqlite (MVP) o postgres (producción)
TENANT_DB_ENGINE=sqlite
# TENANT_DB_DIR=C:\ruta\a\las\bases

# Solo con TENANT_DB_ENGINE=postgres
TENANT_PG_HOST=localhost
TENANT_PG_PORT=5432
TENANT_PG_USER=postgres
TENANT_PG_PASSWORD=

# Dominios de las webs de clientes que consumen la API (separados por coma)
CORS_ALLOWED_ORIGINS=

# Términos y política de privacidad. Al subir la versión, cada usuario los vuelve a aceptar.
# Los datos del responsable aparecen en /legal/terminos/ y /legal/privacidad/.
LEGAL_VERSION=2026-09-22
LEGAL_RESPONSABLE=Cloudin
LEGAL_NIT=
LEGAL_CORREO=
LEGAL_DIRECCION=
LEGAL_CIUDAD=Colombia

# --- Servidor (Cloudflare Containers u otro con Docker) ---------------------
# En el servidor estas van como secretos del Worker, no en un archivo .env.
# Ver DESPLIEGUE-CLOUDFLARE.md. En local se dejan vacías: se usa SQLite.

# Postgres para la base de control y las de cada restaurante (cloudin_<slug>).
# Con ella, TENANT_DB_ENGINE pasa a postgres y TENANT_PG_* salen de esta URL.
# DATABASE_URL=postgresql://usuario:clave@servidor/base?sslmode=require
# Segundos que se reutiliza cada conexión (60 en el servidor).
# DB_CONN_MAX_AGE=0

# Dirección pública del servidor, para los enlaces de invitación y del panel. En Render
# no hace falta: si falta, se usa la del servicio (RENDER_EXTERNAL_HOSTNAME).
# CLOUDIN_PUBLIC_URL=https://cloudin.tu-cuenta.workers.dev
# CSRF_TRUSTED_ORIGINS=https://cloudin.tu-cuenta.workers.dev

# Superusuario que se crea al arrancar si no existe (python manage.py preparar_servidor)
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_PASSWORD=
# DJANGO_SUPERUSER_EMAIL=

# Fotos del menú en Cloudflare R2 (sin R2_BUCKET se guardan en media/)
# R2_BUCKET=cloudin-fotos
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev

# Correo (sin EMAIL_HOST los correos se imprimen en la consola)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Cloudin <no-responder@cloudin.app>
